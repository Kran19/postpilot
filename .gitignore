# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/frontend/node_modules
/backend/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage
*.lcov

# Next.js & Frontend Build Outputs
/.next/
/frontend/.next/
/out/
/frontend/out/
/build

# NestJS & Backend Build Outputs
/dist
/backend/dist
*.tsbuildinfo

# Prisma
/prisma/client
/backend/prisma/client
*.sqlite
*.sqlite-journal

# Environment Files (Do NOT commit sensitive API keys or DB secrets)
.env
.env*
!.env.example
!.env.docker.example

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vercel & Deployment
.vercel

# Misc
*.pem
*.mp4
*.webm
next-env.d.ts

